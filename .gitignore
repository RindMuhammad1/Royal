```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*~
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# MyPy
.mypy_cache/

# PyTest
.pytest_cache/

# Compiled binaries
*.exe
*.dll
*.so
*.a
*.o
*.obj
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```