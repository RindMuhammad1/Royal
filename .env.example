# ==========================================
# Royal Chauffeur UAE - Database & CMS Config
# Copy to .env and fill in real values. NEVER commit real credentials.
# ==========================================

# MySQL connection (preferred: individual params, no URL-encoding needed)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_db_user
DB_PASSWORD=change-me
DB_NAME=your_cpanel_db_name
DB_SSL=false

# Alternative: full connection URL (URL-encode special chars, e.g. '@' -> '%40')
# DATABASE_URL="mysql://user:password@localhost:3306/dbname"

# Admin JWT signing secret - REQUIRED, 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=

# Initial admin (used only by `npm run db:seed`)
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="Royal Administrator"
